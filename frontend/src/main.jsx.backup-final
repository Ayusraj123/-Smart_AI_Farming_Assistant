function Dashboard({ setPage }) {
  const [data, setData] = useState(null);
  const [error, setError] = useState("");

  async function load() {
    try {
      setError("");
      setData(await api("/dashboard"));
    } catch (e) {
      setError(e.message);
    }
  }

  useEffect(() => {
    load();
  }, []);

  if (error) {
    return <div className="alert error">{error}</div>;
  }

  if (!data) {
    return <LoadingCard />;
