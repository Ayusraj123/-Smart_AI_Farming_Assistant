*{box-sizing:border-box}

:root{
  --green-950:#073b2b;
  --green-900:#0b4a36;
  --green-800:#116044;
  --green-700:#187653;
  --green-600:#249565;
  --green-100:#e8f5ee;
  --green-50:#f3faf6;
  --text:#15251e;
  --muted:#718078;
  --border:#e1e9e4;
  --bg:#f6f9f7;
  --white:#fff;
  --danger:#b33a3a;
  --shadow:0 8px 30px rgba(10,55,38,.07);
}

*{scrollbar-width:thin;scrollbar-color:#b9cfc2 transparent}

body{
  margin:0;
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  background:var(--bg);
  color:var(--text);
  -webkit-font-smoothing:antialiased;
}

button,input,select{font:inherit}

button{
  border:0;
  border-radius:10px;
  padding:11px 16px;
  font-weight:700;
  cursor:pointer;
  transition:.18s ease;
}

button:disabled{opacity:.55;cursor:not-allowed}

button:hover:not(:disabled){transform:translateY(-1px)}

input,select{
  width:100%;
  padding:12px 14px;
  border:1px solid #d7e2db;
  border-radius:10px;
  background:#fff;
  color:var(--text);
  outline:none;
  transition:.18s ease;
}

input:focus,select:focus{
  border-color:#56a77f;
  box-shadow:0 0 0 3px rgba(36,149,101,.10);
}

label{
  display:block;
  font-size:13px;
  font-weight:700;
  color:#42544a;
}

label input,label select{margin-top:7px;font-weight:400}

.app-shell{min-height:100vh;display:flex}

.sidebar{
  width:250px;
  position:fixed;
  inset:0 auto 0 0;
  background:linear-gradient(180deg,#083e2d 0%,#063628 100%);
  padding:20px 12px;
  display:flex;
  flex-direction:column;
  z-index:50;
  box-shadow:8px 0 30px rgba(3,45,32,.08);
}

.brand{
  display:flex;
  align-items:center;
  gap:11px;
  padding:5px 9px 27px;
  color:#fff;
  font-weight:800;
}

.brand-icon{
  width:42px;
  height:42px;
  border-radius:12px;
  background:#dff4e7;
  color:#0d6847;
  display:grid;
  place-items:center;
  font-size:22px;
  box-shadow:0 5px 18px rgba(0,0,0,.12);
}

.brand div:last-child{
  font-size:14px;
  line-height:1.15;
}

.brand small{
  display:block;
  color:#a9c9b8;
  font-size:10px;
  margin-top:4px;
  font-weight:600;
}

.nav-item{
  width:100%;
  border:0;
  background:transparent;
  color:#c6d8ce;
  text-align:left;
  padding:12px 14px;
  border-radius:10px;
  margin:3px 0;
  font-weight:700;
  display:flex;
  align-items:center;
  gap:10px;
}

.nav-item:hover{
  background:rgba(255,255,255,.08);
  color:#fff;
}

.nav-item.active,
.nav-item.sel{
  background:#e3f3e9;
  color:#0b4a36;
  box-shadow:0 4px 15px rgba(0,0,0,.08);
}

.signout{
  margin-top:auto;
  color:#c9d7d0;
}

.signout:hover{
  background:rgba(255,255,255,.08);
  color:#fff;
}

.content{
  margin-left:250px;
  width:calc(100% - 250px);
  min-width:0;
}

.topbar{
  height:76px;
  background:rgba(255,255,255,.94);
  backdrop-filter:blur(14px);
  border-bottom:1px solid var(--border);
  padding:0 30px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  position:sticky;
  top:0;
  z-index:30;
}

.topbar h1,.topbar h2{
  margin:0;
  font-size:22px;
  letter-spacing:-.4px;
}

.eyebrow{
  font-size:10px;
  letter-spacing:1.5px;
  font-weight:800;
  color:#7b8a82;
  text-transform:uppercase;
}

.top-user{
  display:flex;
  align-items:center;
  gap:11px;
}

.avatar{
  width:40px;
  height:40px;
  border-radius:50%;
  background:#dff3e7;
  color:#126246;
  display:grid;
  place-items:center;
  font-weight:800;
  border:1px solid #cbe6d6;
}

.main{
  padding:30px;
  max-width:1400px;
}

.page-intro{margin-bottom:24px}

.page-intro h2{
  font-size:28px;
  margin:0 0 7px;
  letter-spacing:-.7px;
}

.page-intro p,.muted{
  color:var(--muted);
  margin:0;
  line-height:1.6;
}

.stats-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
  margin-bottom:22px;
}

.stat-card{
  background:#fff;
  border:1px solid var(--border);
  border-radius:16px;
  padding:20px;
  display:flex;
  align-items:center;
  gap:14px;
  box-shadow:var(--shadow);
}

.stat-card:hover{
  transform:translateY(-2px);
  box-shadow:0 12px 35px rgba(10,55,38,.10);
}

.stat-icon{
  width:46px;
  height:46px;
  border-radius:12px;
  background:var(--green-100);
  color:var(--green-700);
  display:grid;
  place-items:center;
  font-size:20px;
}

.stat-card b{
  display:block;
  font-size:26px;
  letter-spacing:-.5px;
}

.stat-card span{
  font-size:12px;
  color:var(--muted);
}

.hero-card,.card,.table-card,.form-card,.upload-card,.chat-card,.weather-card,.result-card,.quick-card{
  background:#fff;
  border:1px solid var(--border);
  border-radius:16px;
  padding:21px;
  box-shadow:var(--shadow);
  margin-bottom:18px;
}

.hero-card{
  padding:28px;
  background:linear-gradient(135deg,#ffffff 0%,#f1faf5 100%);
}

.hero-emoji{font-size:38px}

.hero-card h2{
  font-size:29px;
  margin:8px 0;
  letter-spacing:-.7px;
}

.section-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:15px;
}

.section-head h3{
  margin:0;
  font-size:17px;
}

.page-toolbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  margin-bottom:20px;
}

.actions{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.primary{
  background:var(--green-700);
  color:#fff;
  box-shadow:0 5px 15px rgba(24,118,83,.18);
}

.primary:hover:not(:disabled){background:var(--green-800)}

.secondary{
  background:#edf5f0;
  color:#116044;
}

.danger-link{
  background:#fff1f1;
  color:var(--danger);
}

.wide{
  width:100%;
  justify-content:center;
}

.grid-2{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:16px;
}

.cards-list{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:16px;
}

.crop-card{
  background:#fff;
  border:1px solid var(--border);
  border-radius:16px;
  padding:19px;
  box-shadow:var(--shadow);
  transition:.18s ease;
}

.crop-card:hover{
  transform:translateY(-2px);
  box-shadow:0 12px 35px rgba(10,55,38,.10);
}

.crop-main{
  display:flex;
  gap:13px;
  align-items:center;
}

.crop-icon{
  width:46px;
  height:46px;
  border-radius:12px;
  background:var(--green-100);
  display:grid;
  place-items:center;
  font-size:22px;
}

.crop-main h3{margin:0 0 4px}

.crop-main p{
  margin:0;
  color:var(--muted);
  font-size:13px;
}

.recommend-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
  padding:14px 0;
  border-bottom:1px solid #edf1ee;
}

.result-content{line-height:1.65}

.result-badge,.confidence{
  display:inline-block;
  background:var(--green-100);
  color:#126246;
  border-radius:20px;
  padding:6px 11px;
  font-weight:800;
  font-size:12px;
}

.result-empty{
  padding:35px;
  text-align:center;
  color:var(--muted);
}

.upload-zone{
  min-height:280px;
  border:2px dashed #a9c8b5;
  background:linear-gradient(145deg,#f5fbf7,#edf7f0);
  border-radius:15px;
  display:grid;
  place-items:center;
  text-align:center;
  padding:25px;
  transition:.18s ease;
}

.upload-zone:hover{
  border-color:#4e9d78;
  background:#f0faf4;
}

.upload-placeholder{
  display:grid;
  gap:8px;
  justify-items:center;
}

.upload-placeholder span{font-size:42px}

.upload-button{margin-top:10px}

.leaf-preview{
  max-width:100%;
  max-height:330px;
  border-radius:13px;
  margin:15px auto;
  display:block;
  box-shadow:0 8px 25px rgba(0,0,0,.08);
}

.disease-layout{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
}

.weather-search{
  display:flex;
  gap:9px;
  margin-bottom:18px;
}

.weather-search input{flex:1}

.weather-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:16px;
}

.weather-card{text-align:center}

.weather-icon{font-size:48px}

.weather-main{
  font-size:34px;
  font-weight:800;
  margin:8px 0;
}

.quick-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}

.quick-card{
  cursor:pointer;
  transition:.18s ease;
}

.quick-card:hover{
  transform:translateY(-3px);
  border-color:#b9dac7;
}

.quick-icon{font-size:28px}

.quick-card h3{
  font-size:15px;
  margin:9px 0 4px;
}

.quick-card p{
  font-size:12px;
  color:var(--muted);
  margin:0;
  line-height:1.5;
}

.quick-questions{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-bottom:15px;
}

.quick-questions button{
  background:#edf5f0;
  color:#126246;
  border:1px solid #dcebe2;
}

.quick-questions button:hover{
  background:#e0f1e7;
}

.chat-card{
  min-height:590px;
  display:flex;
  flex-direction:column;
  padding:16px;
  overflow:hidden;
}

.chat-messages{
  flex:1;
  overflow:auto;
  padding:8px 7px 20px;
  min-height:390px;
}

.chat-msg{
  max-width:75%;
  padding:12px 15px;
  border-radius:15px;
  margin:10px 0;
  line-height:1.55;
  font-size:13px;
  box-shadow:0 2px 8px rgba(0,0,0,.035);
}

.chat-msg.assistant{
  background:#f0f5f2;
  color:#203129;
  border:1px solid #e4ece7;
  border-top-left-radius:5px;
}

.chat-msg.user{
  background:linear-gradient(135deg,#116044,#187653);
  color:#fff;
  margin-left:auto;
  border-top-right-radius:5px;
}

.chat-welcome{
  text-align:center;
  padding:45px 10px;
  color:var(--muted);
}

.chat-input{
  display:flex;
  gap:9px;
  border-top:1px solid #e6ede9;
  padding:14px 0 0;
}

.chat-input input{
  flex:1;
  border-radius:11px;
}

.chat-input button{
  min-width:65px;
}

.form-card{max-width:850px}

.tabs{
  display:flex;
  gap:8px;
  margin-bottom:18px;
}

.tabs button{
  background:#eaf2ed;
  color:#36523f;
}

.tabs button.active{
  background:var(--green-700);
  color:#fff;
}

.center-screen{
  min-height:100vh;
  display:grid;
  place-items:center;
}

.center-card{
  text-align:center;
  background:#fff;
  padding:35px;
  border-radius:17px;
  border:1px solid var(--border);
  box-shadow:var(--shadow);
}

.loader{
  width:30px;
  height:30px;
  border:3px solid #dbe8df;
  border-top-color:var(--green-700);
  border-radius:50%;
  animation:spin .8s linear infinite;
  margin:auto;
}

@keyframes spin{to{transform:rotate(360deg)}}

.empty{
  text-align:center;
  padding:38px;
  color:var(--muted);
}

.empty span{font-size:35px}

.alert{
  padding:11px 13px;
  border-radius:10px;
  margin:12px 0;
  font-size:13px;
}

.alert.error{
  background:#fff0f0;
  color:#9b3030;
  border:1px solid #f4d5d5;
}

.alert.success{
  background:#e9f6ed;
  color:#27633c;
  border:1px solid #d2ead9;
}

.bar{
  height:8px;
  background:#e5eee8;
  border-radius:20px;
  overflow:hidden;
}

.bar>span,.bar>i{
  display:block;
  height:100%;
  background:var(--green-600);
  border-radius:20px;
}

.auth-page{
  min-height:100vh;
  display:grid;
  grid-template-columns:1.08fr .92fr;
  background:#f5f9f6;
}

.auth-art{
  background:linear-gradient(145deg,#063d2c,#0b513b);
  color:#fff;
  padding:10%;
  display:flex;
  align-items:center;
}

.auth-art-inner{max-width:580px}

.big-leaf{font-size:60px}

.auth-art-inner h1{
  font-size:55px;
  line-height:1.02;
  letter-spacing:-2px;
  margin:12px 0;
}

.auth-art-inner p{
  color:#bfd5c7;
  line-height:1.65;
  font-size:16px;
}

.feature-pills{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-top:24px;
}

.feature-pills span{
  background:#ffffff12;
  border:1px solid #ffffff20;
  padding:8px 11px;
  border-radius:20px;
  font-size:12px;
}

.auth-card-wrap{
  display:grid;
  place-items:center;
  padding:35px;
}

.auth-card{
  width:min(450px,100%);
  background:#fff;
  border:1px solid var(--border);
  border-radius:18px;
  padding:30px;
  box-shadow:0 15px 45px rgba(10,55,38,.09);
}

.auth-logo{font-size:32px}

.auth-card h2{
  font-size:29px;
  margin:8px 0;
  letter-spacing:-.5px;
}

.switch-auth{
  text-align:center;
  color:var(--muted);
  margin:18px 0 0;
}

.switch-auth button{
  background:none;
  color:var(--green-700);
  padding:0;
}

@media(max-width:900px){

  .sidebar{width:76px}

  .brand{
    justify-content:center;
    padding-left:0;
    padding-right:0;
  }

  .brand span,
  .brand div:last-child{
    display:none;
  }

  .nav-item{
    font-size:0;
    justify-content:center;
    padding:13px 8px;
  }

  .nav-item::first-letter{font-size:18px}

  .content{
    margin-left:76px;
    width:calc(100% - 76px);
  }

  .stats-grid,
  .cards-list,
  .quick-grid{
    grid-template-columns:1fr 1fr;
  }

  .disease-layout{grid-template-columns:1fr}
}

@media(max-width:650px){

  .sidebar{
    width:0;
    padding:0;
    overflow:hidden;
  }

  .content{
    margin-left:0;
    width:100%;
  }

  .auth-page{grid-template-columns:1fr}

  .auth-art{
    min-height:300px;
    padding:35px 22px;
  }

  .auth-art-inner h1{font-size:38px}

  .auth-card-wrap{padding:22px 16px}

  .topbar{
    height:68px;
    padding:0 15px;
  }

  .topbar h1,.topbar h2{font-size:19px}

  .main{padding:18px 14px}

  .page-intro h2{font-size:24px}

  .grid-2,
  .stats-grid,
  .cards-list,
  .quick-grid,
  .weather-grid{
    grid-template-columns:1fr;
  }

  .recommend-row{grid-template-columns:1fr}

  .page-toolbar,
  .section-head{
    align-items:flex-start;
    flex-direction:column;
  }

  .chat-msg{max-width:90%}

  .chat-card{
    min-height:calc(100vh - 110px);
  }

  .chat-messages{min-height:0}

  .chat-input input{min-width:0}
}
/* =====================================================
   PROFESSIONAL FARM DASHBOARD
   ===================================================== */

.pro-dashboard{
  min-height:100vh;
  background:#f5f8f6;
  color:#17352a;
}

.pro-top{
  height:78px;
  background:#fff;
  border-bottom:1px solid #e3ebe6;
  display:flex;
  align-items:center;
  padding:0 30px;
  gap:25px;
  position:sticky;
  top:0;
  z-index:100;
}

.pro-logo{
  width:230px;
  display:flex;
  align-items:center;
  gap:11px;
  font-weight:800;
  line-height:1.15;
}

.pro-logo-icon{
  width:43px;
  height:43px;
  border-radius:12px;
  background:#e3f4e9;
  display:grid;
  place-items:center;
  font-size:24px;
}

.pro-nav{
  display:flex;
  gap:24px;
  flex:1;
}

.pro-nav button{
  background:none;
  color:#42534b;
  padding:28px 3px;
  border-radius:0;
  font-size:13px;
}

.pro-nav button:hover{
  color:#16845d;
  border-bottom:3px solid #16845d;
}

.pro-search{
  width:220px;
  height:40px;
  border-radius:9px;
}

.pro-user{
  display:flex;
  align-items:center;
  gap:10px;
  white-space:nowrap;
}

.pro-avatar{
  width:39px;
  height:39px;
  border-radius:50%;
  background:#dff3e7;
  color:#126246;
  display:grid;
  place-items:center;
  font-weight:800;
}

.pro-body{
  display:grid;
  grid-template-columns:225px 1fr;
  min-height:calc(100vh - 78px);
}

.pro-sidebar{
  background:linear-gradient(180deg,#073d2c,#052f24);
  padding:24px 13px;
  color:#fff;
  display:flex;
  flex-direction:column;
}

.pro-side-title{
  padding:0 14px 18px;
  color:#9fc2b2;
  font-size:11px;
  letter-spacing:1.5px;
  text-transform:uppercase;
}

.pro-side-btn{
  width:100%;
  background:transparent;
  color:#c7dad1;
  text-align:left;
  padding:12px 14px;
  margin:3px 0;
  border-radius:9px;
  font-size:13px;
}

.pro-side-btn:hover,
.pro-side-btn.active{
  background:#16845d;
  color:white;
}

.pro-signout{
  margin-top:auto;
  border-top:1px solid #315e50;
  padding-top:15px;
}

.pro-content{
  min-width:0;
}

.pro-hero{
  min-height:315px;
  padding:55px 50px;
  color:#fff;
  display:flex;
  align-items:center;
  background:
    linear-gradient(
      90deg,
      rgba(3,58,40,.91),
      rgba(3,58,40,.45),
      rgba(3,58,40,.12)
    ),
    url("https://share.google/qquK3nGcUxoMYhzl6")
    center/cover;
}

.pro-hero h1{
  margin:0 0 10px;
  font-size:40px;
}

.pro-hero p{
  font-size:17px;
  margin:7px 0;
}

.pro-hero-btn{
  margin-top:20px;
  background:#16845d;
  color:#fff;
  border:0;
  padding:13px 22px;
  border-radius:9px;
  font-weight:700;
}

.pro-main{
  max-width:1250px;
  margin:auto;
  padding:0 30px 35px;
}

.pro-stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
  margin-top:-48px;
  position:relative;
}

.pro-stat{
  background:#fff;
  border:1px solid #e1ebe5;
  border-radius:13px;
  padding:19px;
  display:flex;
  align-items:center;
  gap:14px;
  box-shadow:0 7px 25px rgba(0,50,35,.09);
}

.pro-stat-icon{
  width:50px;
  height:50px;
  border-radius:12px;
  background:#e7f6ed;
  display:grid;
  place-items:center;
  font-size:25px;
}

.pro-stat strong{
  display:block;
  font-size:24px;
}

.pro-stat span{
  color:#718078;
  font-size:12px;
}

.pro-grid{
  display:grid;
  grid-template-columns:2fr 1fr;
  gap:20px;
  margin-top:22px;
}

.pro-card{
  background:#fff;
  border:1px solid #e1ebe5;
  border-radius:14px;
  padding:22px;
}

.pro-card-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:17px;
}

.pro-card-head h2{
  margin:0;
  font-size:19px;
}

.pro-card-head span{
  color:#16845d;
  font-size:12px;
  font-weight:700;
}

.pro-actions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:13px;
}

.pro-action{
  background:#fff;
  border:1px solid #e4ebe7;
  border-radius:11px;
  padding:16px;
  display:flex;
  align-items:center;
  gap:12px;
  text-align:left;
}

.pro-action:hover{
  border-color:#8bc9a9;
  box-shadow:0 5px 15px rgba(0,80,50,.08);
}

.pro-action-icon{
  width:45px;
  height:45px;
  border-radius:10px;
  background:#edf8f1;
  display:grid;
  place-items:center;
  font-size:22px;
  flex-shrink:0;
}

.pro-action strong,
.pro-action small{
  display:block;
}

.pro-action small{
  color:#78867f;
  font-size:11px;
  margin-top:4px;
}

.pro-tip{
  margin-top:15px;
  padding:16px;
  background:#e8f7ed;
  border-radius:11px;
  display:flex;
  align-items:center;
  gap:13px;
}

.pro-tip-icon{
  font-size:27px;
}

.pro-tip strong{
  display:block;
  color:#126b4b;
}

.pro-tip small{
  color:#718078;
}

.pro-activity{
  height:185px;
  background:#edf8f1;
  border-radius:11px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  color:#6f7d76;
}

.pro-activity span{
  font-size:30px;
  margin-bottom:8px;
}

.pro-activity strong{
  color:#283d34;
  margin-bottom:5px;
}

.pro-crops{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:11px;
}

.pro-crop{
  background:#f7faf8;
  border-radius:10px;
  padding:13px 5px;
  text-align:center;
}

.pro-crop div{
  font-size:29px;
}

.pro-crop strong{
  display:block;
  font-size:11px;
  margin-top:4px;
}

.pro-footer{
  background:#073b2b;
  color:#c7ddd4;
  padding:35px max(30px,calc((100% - 1250px)/2));
  display:grid;
  grid-template-columns:2fr 1fr 1fr 1fr;
  gap:35px;
}

.pro-footer h3{
  color:#fff;
  margin-top:0;
}

.pro-footer span{
  display:block;
  margin:7px 0;
  font-size:12px;
}

.pro-footer p{
  font-size:12px;
  line-height:1.6;
}

@media(max-width:1000px){
  .pro-nav{
    gap:10px;
  }

  .pro-search{
    display:none;
  }

  .pro-stats{
    grid-template-columns:1fr 1fr;
  }

  .pro-grid{
    grid-template-columns:1fr;
  }
}

@media(max-width:700px){
  .pro-top{
    padding:0 15px;
  }

  .pro-nav{
    display:none;
  }

  .pro-logo{
    width:auto;
  }

  .pro-body{
    grid-template-columns:1fr;
  }

  .pro-sidebar{
    display:none;
  }

  .pro-hero{
    padding:40px 25px;
  }

  .pro-hero h1{
    font-size:29px;
  }

  .pro-main{
    padding:0 15px 25px;
  }

  .pro-stats{
    grid-template-columns:1fr 1fr;
    margin-top:-30px;
  }

  .pro-actions{
    grid-template-columns:1fr;
  }

  .pro-footer{
    grid-template-columns:1fr 1fr;
  }
}

@media(max-width:480px){
  .pro-stats{
    grid-template-columns:1fr;
  }

  .pro-footer{
    grid-template-columns:1fr;
  }
}
/* ===== FARM HERO BACKGROUND ===== */
.NEW-HERO,
.dashboard-hero,
.hero-card {
  background-image:
    linear-gradient(
      90deg,
      rgba(0, 55, 38, 0.78) 0%,
      rgba(0, 55, 38, 0.48) 45%,
      rgba(0, 0, 0, 0.18) 100%
    ),
    url("https://share.google/qquK3nGcUxoMYhzl6");

  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

/* Hero text */
.NEW-HERO h1,
.NEW-HERO h2,
.dashboard-hero h1,
.dashboard-hero h2,
.hero-card h1,
.hero-card h2 {
  color: #fff;
  text-shadow: 0 2px 8px rgba(0,0,0,.35);
}

/* Hero height */
.NEW-HERO,
.dashboard-hero,
.hero-card {
  min-height: 320px;
  position: relative;
  overflow: hidden;
}

/* Mobile */
@media (max-width: 700px) {
  .NEW-HERO,
  .dashboard-hero,
  .hero-card {
    min-height: 360px;
    background-position: center;
  }
}

.NEW-HERO,
.NEW-HERO-TEXT,
.dashboard-page .dashboard-hero,
.dashboard-page .hero,
.hero-card {
  background-image:
    linear-gradient(
      90deg,
      rgba(0, 45, 30, 0.60),
      rgba(0, 45, 30, 0.20)
    ),
    url("/farm-bg.jpg") !important;

  background-size: cover !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
}